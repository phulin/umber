/third_party

# Locally generated end-to-end conformance oracles. These are derived from
# third-party documents and must never be committed.
/tests/corpus/e2e/story.expected.dvi
/tests/corpus/e2e/gentle.expected.dvi
/tests/corpus/e2e/trip.expected.dvi
/tests/corpus/e2e/etrip.expected.dvi

.codex
.claude

.umber

# Deferred-tier run records, written by scripts/tier-runner.sh and printed by
# the routine gates. They are facts about one working tree, not about a branch:
# a tier that passed in another checkout is no evidence for this one.
/.tier-stamps/

# Parallel subagent worktrees
.worktrees/

notes.md

.env

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
.beads/interactions.jsonl
.beads/config.yaml

# Generated-on-demand full-document TeX82 semantic traces (17-156 MB each);
# rebuild with scripts/build-tex82-document-traces.sh.
/tests/corpus/command/tex82-documents/
