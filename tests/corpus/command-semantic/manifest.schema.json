{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://umber.dev/schema/command-semantic-manifest-v1.json",
  "title": "Umber command semantic minifixture domain manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "domain", "cases"],
  "properties": {
    "schema": { "const": 1 },
    "domain": { "$ref": "#/$defs/slug" },
    "property_domain": { "$ref": "#/$defs/slug" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "property_id", "source", "provenance", "projection", "expected", "expectation"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "property_id": { "type": "string", "minLength": 1 },
        "profile": { "enum": ["initex", "production", "etex-initex"] },
        "font_inputs": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "source": { "type": "string", "pattern": "^[^/]+\\.tex$" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "projection": { "$ref": "#/$defs/projection" },
        "channels": { "$ref": "#/$defs/channels" },
        "expected": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "expectation": { "$ref": "#/$defs/expectation" },
        "terminal_lines": {
          "type": "array",
          "items": { "type": "string", "maxLength": 4096 }
        },
        "inputs": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "interaction_mode": {
          "description": "tex.web's -interaction mode this case's job runs under. Defaults to scrollmode, the mode scripts/run-minifixture-oracle.sh's standard sweep runs every case under. A case that declares any other value must also carry interaction_mode_note explaining why its channels are not comparable to that standard sweep.",
          "enum": ["scrollmode", "errorstopmode", "nonstopmode", "batchmode"]
        },
        "interaction_mode_note": {
          "description": "Required exactly when interaction_mode is not scrollmode: explains what this case's channels are compared against instead of the standard scrollmode oracle sweep.",
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "manifest", "sections"],
      "properties": {
        "authority": { "type": "string", "minLength": 1 },
        "manifest": { "type": "string", "minLength": 1 },
        "sections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "channels": {
      "description": "The disposition of every observable this case's run produces. A projection asserts one observable; this block accounts for the rest of the same run, so a case cannot ship a page or write a log that nothing compares. Required for every case whose run completes; a case pinned as `xfail` because its run does not complete may omit it, and the exemption expires with the bug.",
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "status", "terminal", "log", "dvi", "effects"],
      "properties": {
        "events": {
          "description": "Exact number of committed observations. Counted rather than committed: the canonical event stream's oracle-backed home is the tex82 fixture tree, and duplicating it here would commit an Umber self-golden.",
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "description": "Terminal state: `clean`, or `fatal:<label>` when the job ended through tex.web section 81 `jump_out`.",
          "type": "string",
          "pattern": "^(clean|fatal:.+)$"
        },
        "terminal": { "$ref": "#/$defs/streamDisposition" },
        "log": { "$ref": "#/$defs/streamDisposition" },
        "dvi": { "$ref": "#/$defs/streamDisposition" },
        "effects": { "$ref": "#/$defs/streamDisposition" }
      }
    },
    "streamDisposition": {
      "oneOf": [
        {
          "description": "The channel must produce nothing. No committed file may exist for it.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "empty" } }
        },
        {
          "description": "The channel must match `expected/<case-id>.<channel>` byte for byte.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "authority"],
          "properties": {
            "kind": { "const": "file" },
            "authority": { "$ref": "#/$defs/channelAuthority" }
          }
        },
        {
          "description": "The committed file holds the reference engine's bytes, exactly as `file` does. Umber does not yet match them; `mismatch` pins where its output first diverges, and `bug` names the issue that retires the pin.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "bug", "authority", "mismatch"],
          "properties": {
            "kind": { "const": "xfail" },
            "bug": { "type": "string", "pattern": "^umber2-[a-z0-9]+(?:\\.[a-z0-9]+)*$" },
            "authority": { "$ref": "#/$defs/channelAuthority" },
            "mismatch": { "$ref": "#/$defs/channelMismatch" }
          }
        }
      ]
    },
    "channelMismatch": {
      "description": "Where Umber's output for one channel first diverges from the committed reference bytes. `expected` and `actual` use the literal `<end of channel>` for a side that ran out first.",
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "expected", "actual"],
      "properties": {
        "line": {
          "description": "1-based line number of the first divergence.",
          "type": "integer",
          "minimum": 1
        },
        "expected": { "type": "string" },
        "actual": { "type": "string" }
      }
    },
    "channelAuthority": {
      "description": "Where a committed channel's bytes came from. `oracle` means a pinned reference engine produced them. `umber-baseline` means Umber produced them: they are pinned against silent drift and still owed an oracle adjudication.",
      "enum": ["oracle", "umber-baseline"]
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "classification",
            "condition-steps",
            "skipping-condition-steps",
            "branch-selections",
            "predicate-outcomes",
            "observations",
            "execution-boundaries",
            "state",
            "terminal-checks"
          ]
        },
        "count_registers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        },
        "include_count_mutations": { "type": "boolean" },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "command",
              "input",
              "recovery",
              "scanner-status",
              "macro",
              "scanner",
              "token-list",
              "mutation",
              "diagnostic",
              "effect"
            ]
          }
        },
        "commands": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "command_names": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "alignment_transitions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "box_registers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        },
        "node_depth": { "type": "integer", "minimum": 0, "maximum": 8 },
        "include_mode_transitions": { "type": "boolean" },
        "include_artifact_hashes": { "type": "boolean" },
        "terminal_checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    },
    "expectation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "pass" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "bug", "mismatch"],
          "properties": {
            "kind": { "const": "xfail" },
            "bug": { "type": "string", "pattern": "^umber2-[a-z0-9]+(?:\\.[a-z0-9]+)*$" },
            "mismatch": { "$ref": "#/$defs/mismatch" }
          }
        }
      ]
    },
    "mismatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "kind", "expected", "actual"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "kind": { "enum": ["observation", "missing", "extra", "execution"] },
        "expected": { "type": "string", "minLength": 1 },
        "actual": { "type": "string", "minLength": 1 }
      }
    }
  }
}
