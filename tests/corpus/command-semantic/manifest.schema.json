{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://umber.dev/schema/command-semantic-manifest-v1.json",
  "title": "Umber command semantic minifixture domain manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "domain", "cases"],
  "properties": {
    "schema": { "const": 1 },
    "domain": { "$ref": "#/$defs/slug" },
    "property_domain": { "$ref": "#/$defs/slug" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "property_id", "source", "provenance", "projection", "expected", "expectation"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "property_id": { "type": "string", "minLength": 1 },
        "profile": { "enum": ["initex", "production", "etex-initex"] },
        "font_inputs": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "source": { "type": "string", "pattern": "^[^/]+\\.tex$" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "projection": { "$ref": "#/$defs/projection" },
        "expected": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "expectation": { "$ref": "#/$defs/expectation" },
        "terminal_lines": {
          "type": "array",
          "items": { "type": "string", "maxLength": 4096 }
        },
        "inputs": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "manifest", "sections"],
      "properties": {
        "authority": { "type": "string", "minLength": 1 },
        "manifest": { "type": "string", "minLength": 1 },
        "sections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "classification",
            "condition-steps",
            "skipping-condition-steps",
            "branch-selections",
            "predicate-outcomes",
            "observations",
            "execution-boundaries",
            "state",
            "terminal-checks"
          ]
        },
        "count_registers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        },
        "include_count_mutations": { "type": "boolean" },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "command",
              "input",
              "recovery",
              "scanner-status",
              "macro",
              "scanner",
              "token-list",
              "mutation",
              "diagnostic",
              "effect"
            ]
          }
        },
        "commands": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "command_names": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "alignment_transitions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "box_registers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        },
        "node_depth": { "type": "integer", "minimum": 0, "maximum": 8 },
        "include_mode_transitions": { "type": "boolean" },
        "include_artifact_hashes": { "type": "boolean" },
        "terminal_checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    },
    "expectation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "pass" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "bug", "mismatch"],
          "properties": {
            "kind": { "const": "xfail" },
            "bug": { "type": "string", "pattern": "^umber2-[a-z0-9]+(?:\\.[a-z0-9]+)*$" },
            "mismatch": { "$ref": "#/$defs/mismatch" }
          }
        }
      ]
    },
    "mismatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "kind", "expected", "actual"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "kind": { "enum": ["observation", "missing", "extra", "execution"] },
        "expected": { "type": "string", "minLength": 1 },
        "actual": { "type": "string", "minLength": 1 }
      }
    }
  }
}
