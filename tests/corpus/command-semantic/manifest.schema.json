{
  "$defs": {
    "CapturePolicy": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "profile",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "exclude",
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "CaseInteractionMode": {
      "description": "tex.web's four `-interaction` modes, spelled exactly as pdfTeX's own flag\ndoes (`-interaction=scrollmode`, ...) so a case's declared value can be\nhanded straight to the oracle runner's command line.",
      "enum": [
        "scrollmode",
        "errorstopmode",
        "nonstopmode",
        "batchmode"
      ],
      "type": "string"
    },
    "ChannelContractV2": {
      "additionalProperties": false,
      "properties": {
        "diagnostics": {
          "anyOf": [
            {
              "$ref": "#/$defs/StreamDisposition"
            },
            {
              "type": "null"
            }
          ]
        },
        "dvi": {
          "anyOf": [
            {
              "$ref": "#/$defs/StreamDisposition"
            },
            {
              "type": "null"
            }
          ]
        },
        "effects": {
          "anyOf": [
            {
              "$ref": "#/$defs/StreamDisposition"
            },
            {
              "type": "null"
            }
          ]
        },
        "events": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "log": {
          "anyOf": [
            {
              "$ref": "#/$defs/StreamDisposition"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "terminal": {
          "anyOf": [
            {
              "$ref": "#/$defs/StreamDisposition"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "events"
      ],
      "type": "object"
    },
    "ChannelMismatch": {
      "additionalProperties": false,
      "description": "Where an `xfail` channel's observed divergence from its committed\nreference bytes was first pinned.\n\n`expected` and `actual` are the two sides' rendering of that one line,\nusing the literal `<end of channel>` for a side that ran out first --\nexactly as a `file` channel's own line-difference report does.",
      "properties": {
        "actual": {
          "description": "Umber's observed line at that point.",
          "type": "string"
        },
        "expected": {
          "description": "The committed reference engine's line at that point.",
          "type": "string"
        },
        "line": {
          "description": "1-based line number of the first divergence.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "line",
        "expected",
        "actual"
      ],
      "type": "object"
    },
    "Expectation": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "pass",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "bug": {
              "type": "string"
            },
            "kind": {
              "const": "xfail",
              "type": "string"
            },
            "mismatch": {
              "$ref": "#/$defs/MismatchFingerprint"
            }
          },
          "required": [
            "kind",
            "bug",
            "mismatch"
          ],
          "type": "object"
        }
      ]
    },
    "MismatchFingerprint": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "type": "string"
        },
        "expected": {
          "type": "string"
        },
        "index": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "type": "string"
        }
      },
      "required": [
        "index",
        "kind",
        "expected",
        "actual"
      ],
      "type": "object"
    },
    "ObservationKind": {
      "enum": [
        "command",
        "input",
        "alignment",
        "recovery",
        "scanner-status",
        "macro",
        "scanner",
        "token-list",
        "mutation",
        "diagnostic",
        "effect"
      ],
      "type": "string"
    },
    "Projection": {
      "additionalProperties": false,
      "properties": {
        "alignment_transitions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "box_registers": {
          "default": [],
          "items": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "command_names": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "commands": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "count_registers": {
          "default": [],
          "items": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "include_artifact_hashes": {
          "default": false,
          "type": "boolean"
        },
        "include_count_mutations": {
          "default": false,
          "type": "boolean"
        },
        "include_mode_transitions": {
          "default": false,
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/ProjectionKind"
        },
        "kinds": {
          "items": {
            "$ref": "#/$defs/ObservationKind"
          },
          "type": "array"
        },
        "node_depth": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "terminal_checks": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "ProjectionKind": {
      "enum": [
        "classification",
        "condition-steps",
        "skipping-condition-steps",
        "branch-selections",
        "predicate-outcomes",
        "observations",
        "execution-boundaries",
        "state",
        "terminal-checks"
      ],
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "type": "string"
        },
        "manifest": {
          "type": "string"
        },
        "sections": {
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "authority",
        "manifest",
        "sections"
      ],
      "type": "object"
    },
    "SessionProfile": {
      "enum": [
        "initex",
        "etex-initex",
        "etex-loaded",
        "production",
        "raw-tex82-loaded"
      ],
      "type": "string"
    },
    "StreamDisposition": {
      "description": "What a case declares about one stream channel.\n\nEvery committed channel file holds the pinned reference engine's bytes --\nthat is the one meaning a committed file has, for `file` and `xfail`\nalike (`umber2-alfh.7`). There is therefore exactly one place bytes can\nhave come from, which is why this type carries no `authority` field: a\nfield that can only ever hold one value distinguishes nothing, and a\nsecond source (an unadjudicated implementation-observed baseline, this\ncorpus's own prior authority value until `umber2-alfh.1`) is now\nimpossible to declare rather than merely unused.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The channel must produce nothing at all.",
          "properties": {
            "kind": {
              "const": "empty",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The channel must match the committed reference-engine file byte for\nbyte.",
          "properties": {
            "kind": {
              "const": "file",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "No portable reference projection exists for this channel in this\ncase. This is allowed only for `effects`, must carry a reviewed reason,\nand commits no expected bytes. It is an explicit absence of a verdict,\nnever a baseline derived from Umber's output.",
          "properties": {
            "kind": {
              "const": "unsupported",
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The committed file always holds the reference engine's bytes for this\nchannel -- that is the one meaning a committed channel file has, `file`\nor `xfail` alike. This disposition instead says Umber does not yet\nproduce those bytes, and pins exactly how: `mismatch` names the first\nline at which Umber's output diverges from the committed reference, so\na change in *what* diverges cannot be mistaken for the pinned bug.\n`bug` names the issue that will retire this disposition.",
          "properties": {
            "bug": {
              "type": "string"
            },
            "kind": {
              "const": "xfail",
              "type": "string"
            },
            "mismatch": {
              "$ref": "#/$defs/ChannelMismatch"
            }
          },
          "required": [
            "kind",
            "bug",
            "mismatch"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Umber's diagnostics do not yet match the reference engine's, but\neverything the channel prints *outside* a diagnostic does.\n\n`xfail` writes a whole channel off and checks only that its first\ndivergence is still the pinned one, so nothing after that line is\ncompared at all and every improvement to a report churns the pin. This\ndisposition keeps comparing the channel with tex.web §82's error\nreports removed from both sides (see [`strip_diagnostic_reports`]), so\nthe file framing, page output, and job tail a divergent diagnostic\nused to hide stay under test. `bug` names the issue that will retire\nit; the channel matching the reference *raw* is an xpass exactly as it\nis for `xfail`.",
          "properties": {
            "bug": {
              "type": "string"
            },
            "kind": {
              "const": "xfail-diagnostics",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "bug"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capture": {
      "$ref": "#/$defs/CapturePolicy"
    },
    "channels": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChannelContractV2"
        },
        {
          "type": "null"
        }
      ]
    },
    "expectation": {
      "$ref": "#/$defs/Expectation"
    },
    "expected": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "font_inputs": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "type": "object"
    },
    "inputs": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "type": "object"
    },
    "interaction_mode": {
      "$ref": "#/$defs/CaseInteractionMode"
    },
    "interaction_mode_note": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "profile": {
      "$ref": "#/$defs/SessionProfile"
    },
    "projection": {
      "$ref": "#/$defs/Projection"
    },
    "property_id": {
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "schema": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "terminal_lines": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "property_id",
    "provenance",
    "projection",
    "expected"
  ],
  "title": "CaseManifestV2",
  "type": "object"
}
